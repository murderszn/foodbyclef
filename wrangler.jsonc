{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foodbyclef",
  "account_id": "50757702d22b61e335a75483c1d5b325",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1070301", "simple": { "limit": 5, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "DAILY_BUDGET", "class_name": "DailyBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyBudget"] }],
  "vars": { "DAILY_REQUEST_LIMIT": "1000" }
}
